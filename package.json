{
  "name": "@naakwu/flowkit-workspace",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test scripts && bun run --filter './packages/*' test",
    "build": "bun run --filter './packages/*' build",
    "pack:check": "bun run scripts/pack-check.ts",
    "version:check": "bun run scripts/check-lockstep-versions.ts && bun test scripts/check-lockstep-versions.test.ts",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:plan": "changeset status --output .changeset/release-plan.json",
    "release:validate": "bun run scripts/validate-release-plan.ts",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0"
  }
}
