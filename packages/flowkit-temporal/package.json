{
  "name": "@flowkit/temporal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Temporal interpreter for serialized Flowkit definitions",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js",
      "require": "./dist/workflow.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/workflow.ts --format esm,cjs --dts --clean",
    "test": "bun test src"
  },
  "dependencies": {
    "@flowkit/core": "file:../flowkit-core",
    "@temporalio/workflow": "1.16.2"
  },
  "devDependencies": {
    "@temporalio/testing": "1.16.2",
    "@temporalio/worker": "1.16.2",
    "@noble/hashes": "^2.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
