{
  "name": "@naakwu/flowkit-definitions",
  "version": "1.0.0",
  "private": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "description": "Flow definition authoring format: YAML binding and the emitted JSON Schema",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flowkit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "schema"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --clean && bun run schema:emit",
    "schema:emit": "bun run scripts/emit-schema.ts",
    "test": "bun test test"
  },
  "dependencies": {
    "@naakwu/flowkit-core": "workspace:^",
    "@naakwu/flowkit-temporal": "workspace:^",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "tsup": "^9.0.0",
    "typescript": "^7",
    "zod-to-json-schema": "^3.25.0"
  }
}
