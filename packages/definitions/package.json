{
  "name": "@teopeurt/flowkit-definitions",
  "version": "1.1.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "description": "Flow definition authoring format: YAML binding and the emitted JSON Schema",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flowkit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/bin.ts --format esm,cjs --dts --clean && bun run schema:emit",
    "schema:emit": "bun run scripts/emit-schema.ts",
    "test": "bun test test"
  },
  "dependencies": {
    "@teopeurt/flowkit-core": "workspace:^",
    "@teopeurt/flowkit-temporal": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@temporalio/testing": "1.16.2",
    "@temporalio/worker": "1.16.2",
    "@temporalio/workflow": "1.16.2",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "zod-to-json-schema": "^3.25.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teopeurt/flowkit.git",
    "directory": "packages/definitions"
  },
  "homepage": "https://github.com/teopeurt/flowkit",
  "bugs": {
    "url": "https://github.com/teopeurt/flowkit/issues"
  }
}
