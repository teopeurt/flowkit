{
  "name": "@naakwu/flowkit-notify",
  "version": "1.0.0",
  "private": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "description": "Portable notification planning and delivery runtime",
  "main": "./dist/index.cjs",
