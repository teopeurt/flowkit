    "test": "bun test src"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7"
  }
}
