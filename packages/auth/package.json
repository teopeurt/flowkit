{
  "name": "@naakwu/flowkit-auth",
  "version": "0.2.0",
  "private": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "description": "Portable authentication, authorization, identity, and Nest integration",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./roles": { "types": "./dist/roles/index.d.ts", "import": "./dist/roles/index.js", "require": "./dist/roles/index.cjs" },
    "./better-auth": { "types": "./dist/better-auth/index.d.ts", "import": "./dist/better-auth/index.js", "require": "./dist/better-auth/index.cjs" },
    "./nest": { "types": "./dist/nest/index.d.ts", "import": "./dist/nest/index.js", "require": "./dist/nest/index.cjs" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js", "require": "./dist/testing/index.cjs" }
  },
  "files": ["dist", "README.md"],
  "scripts": { "typecheck": "tsc --noEmit", "build": "tsup --config tsup.config.ts", "test": "bun test src" },
  "dependencies": { "zod": "^4.5.4" },
  "peerDependencies": { "better-auth": "1.7.2", "@nestjs/common": "^11.1.9", "@nestjs/core": "^11.1.9", "reflect-metadata": "^0.2.0" },
  "devDependencies": { "@types/bun": "latest", "better-auth": "1.7.2", "@nestjs/common": "12.0.1", "@nestjs/core": "12.0.1", "reflect-metadata": "^0.2.0", "tsup": "^8.5.0", "typescript": "^7" }
}
