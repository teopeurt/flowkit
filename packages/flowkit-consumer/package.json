{
  "name": "@flowkit/consumer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engine-neutral consumer facade and runtime port for Flowkit",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "bun test test"
  },
  "dependencies": {
    "@flowkit/core": "file:../flowkit-core",
    "@flowkit/tasks": "file:../flowkit-tasks"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
