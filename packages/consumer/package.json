{
  "name": "@teopeurt/flowkit-consumer",
  "version": "1.0.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "description": "Engine-neutral consumer facade and runtime port for Flowkit",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "bun test test"
  },
  "dependencies": {
    "@teopeurt/flowkit-core": "workspace:^",
    "@teopeurt/flowkit-tasks": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teopeurt/flowkit.git",
    "directory": "packages/consumer"
  },
  "homepage": "https://github.com/teopeurt/flowkit",
  "bugs": {
    "url": "https://github.com/teopeurt/flowkit/issues"
  }
}
