{
  "name": "@teopeurt/flowkit-temporal",
  "version": "1.1.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "description": "Reusable Temporal interpreter for serialized Flowkit definitions",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js",
      "require": "./dist/workflow.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/workflow.ts --format esm,cjs --dts --clean",
    "test": "bun test src"
  },
  "dependencies": {
    "@teopeurt/flowkit-consumer": "workspace:^",
    "@teopeurt/flowkit-core": "workspace:^",
    "@noble/hashes": "^2.0.1",
    "@temporalio/workflow": "1.16.2"
  },
  "devDependencies": {
    "@temporalio/client": "1.16.2",
    "@temporalio/common": "1.16.2",
    "@temporalio/testing": "1.16.2",
    "@temporalio/worker": "1.16.2",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teopeurt/flowkit.git",
    "directory": "packages/temporal"
  },
  "homepage": "https://github.com/teopeurt/flowkit",
  "bugs": {
    "url": "https://github.com/teopeurt/flowkit/issues"
  }
}
