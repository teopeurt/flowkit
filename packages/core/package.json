{
  "name": "@teopeurt/flowkit-core",
  "version": "1.1.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Engine-agnostic workflow definitions and pure transition evaluation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "bun test src"
  },
  "dependencies": {
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teopeurt/flowkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/teopeurt/flowkit",
  "bugs": {
    "url": "https://github.com/teopeurt/flowkit/issues"
  }
}
