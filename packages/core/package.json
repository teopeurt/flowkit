{
  "name": "@naakwu/flowkit-core",
  "version": "1.0.0",
  "private": false,
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "description": "Engine-agnostic workflow definitions and pure transition evaluation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "bun test src"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7"
  }
}
